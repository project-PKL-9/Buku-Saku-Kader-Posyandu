<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Buku Saku 25 Keterampilan Dasar Kader Posyandu</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
:root {
    --primary: #084873;
    --secondary: #35c9c9;
    --background: #edf4f7;
    --white: #fff;
    --text: #263746;
    --muted: #647786;
    --border: #dce7ed;
    --shadow: 0 8px 25px rgba(8,72,115,.10);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Poppins, sans-serif;
    background: var(--background);
    color: var(--text);
    line-height: 1.8;
}

img {
    max-width: 100%;
    display: block;
}

a {
    text-decoration: none;
    color: inherit;
}

/* NAVBAR */
.navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: rgba(255,255,255,.97);
    box-shadow: 0 3px 15px rgba(0,0,0,.07);
    backdrop-filter: blur(10px);
}

.nav-container {
    max-width: 1200px;
    margin: auto;
    padding: 12px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
}

.nav-brand {
    font-size: 15px;
    font-weight: 650;
    color: var(--primary);
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 18px;
}

.nav-links a {
    font-size: 12px;
    font-weight: 500;
    color: var(--text);
    transition: .3s;
}

.nav-links a:hover,
.nav-links a.active {
    color: #159baf;
}

.menu-toggle {
    display: none;
    border: 0;
    background: transparent;
    font-size: 25px;
    color: var(--primary);
    cursor: pointer;
}

main {
    padding-top: 65px;
}

section {
    padding: 65px 24px;
    scroll-margin-top: 75px;
}

.container {
    width: 90%;
    max-width: 1000px;
    margin: auto;
}

/* JUDUL BAGIAN */
.section-heading {
    text-align: center;
    margin-bottom: 35px;
}

.section-heading h2 {
    color: var(--primary);
    font-size: 30px;
    font-weight: 600;
    line-height: 1.4;
}

.section-heading p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 14px;
}

/* KARTU MATERI */
.card {
    background: var(--white);
    border-radius: 18px;
    padding: 28px;
    margin-bottom: 24px;
    box-shadow: var(--shadow);
}

.card h3 {
    color: var(--primary);
    font-size: 20px;
    margin: 18px 0 12px;
}

.card h4 {
    color: var(--primary);
    margin: 20px 0 8px;
}

.card p {
    margin-bottom: 12px;
}

.card ul,
.card ol {
    padding-left: 24px;
    margin-bottom: 14px;
}

.card li {
    margin-bottom: 7px;
}

.highlight {
    color: #159baf;
    font-weight: 700;
}

.info-box {
    padding: 18px;
    background: #e9f9fa;
    border-left: 5px solid var(--secondary);
    border-radius: 10px;
    margin: 18px 0;
}

/* COVER */
.cover {
    min-height: calc(100svh - 65px);
    display: flex;
    align-items: center;
    background:
        linear-gradient(
            90deg,
            rgba(5,45,77,.88),
            rgba(5,45,77,.50)
        ),
        url('cover.jpeg') center/cover no-repeat;
    color: #fff;
    padding: 70px 8%;
}

.cover-content {
    max-width: 1000px;
}

.collab-logos {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 18px;
    margin-bottom: 20px;
}

.collab-logos img {
    width: 75px;
    height: 75px;
    object-fit: contain;
}

.cover-label {
    display: inline-block;
    background: var(--secondary);
    color: #063b56;
    padding: 6px 16px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    margin-bottom: 20px;
}

.cover h1 {
    font-size: clamp(32px,5vw,58px);
    line-height: 1.15;
    font-weight: 700;
    margin-bottom: 20px;
}

.cover h1 span {
    color: var(--secondary);
    display: block;
}

.cover-subtitle {
    font-size: 18px;
    max-width: 580px;
    margin-bottom: 18px;
}

.cover-partner {
    display: block;
    margin-top: 8px;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: .5px;
    line-height: 1.5;
    color: #fff;
}

/* GALERI */
#galeri {
    background: linear-gradient(180deg,#fff 0%,#edf4f7 100%);
    padding: 75px 24px;
}

#galeri .section-heading {
    max-width: 650px;
    margin: 0 auto 30px;
}

.gallery-label {
    display: inline-block;
    color: #159baf;
    background: #e0f7f8;
    padding: 6px 16px;
    border-radius: 30px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
    margin-bottom: 12px;
}

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: 26px;
    max-width: 1000px;
    margin: 0 auto;
}

.gallery-item {
    position: relative;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 12px;
    overflow: hidden;
    box-shadow: var(--shadow);
}

.gallery-image {
    width: 100%;
    height: 280px;
    overflow: hidden;
    border-radius: 12px;
    background: #edf4f7;
}

.gallery-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: zoom-in;
}

.gallery-caption {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px 8px 8px;
}

.gallery-caption span {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #e0f7f8;
    color: #084873;
    font-size: 12px;
    font-weight: 800;
}

.gallery-caption p {
    color: #084873;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.6;
}

.gallery-actions {
    display: flex;
    gap: 7px;
    margin: 8px 0 2px;
}

.gallery-actions button {
    border: 0;
    border-radius: 8px;
    padding: 7px 10px;
    font: 600 10px Poppins;
    cursor: pointer;
}

.btn-delete {
    background: #ffe8e8;
    color: #b42318;
}

.add-photo-wrap {
    text-align: center;
    margin-top: 25px;
}

.add-photo-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 0;
    background: var(--primary);
    color: #fff;
    border-radius: 10px;
    padding: 11px 18px;
    font: 700 11px Poppins;
    cursor: pointer;
}

.add-photo-btn:hover {
    background: #063b56;
}

/* BAB III */
.chapter-banner {
    background: linear-gradient(135deg,var(--primary),#0b678b);
    color: #fff;
    padding: 30px;
    border-radius: 18px;
    margin-bottom: 25px;
    box-shadow: var(--shadow);
}

.chapter-label {
    display: inline-block;
    background: var(--secondary);
    color: #063b56;
    font-weight: 800;
    font-size: 12px;
    padding: 5px 13px;
    border-radius: 30px;
    margin-bottom: 12px;
}

.chapter-banner h2 {
    font-size: clamp(24px,4vw,34px);
    line-height: 1.35;
    margin-bottom: 8px;
}

.chapter-banner p {
    font-size: 14px;
    opacity: .95;
}

.intro-box {
    background: #fff;
    border-radius: 14px;
    padding: 22px;
    margin: 20px 0;
    border-left: 5px solid var(--secondary);
    box-shadow: var(--shadow);
}

.intro-box h3 {
    color: var(--primary);
    margin-bottom: 8px;
    font-size: 19px;
}

.intro-box p {
    margin-bottom: 0;
}

.subsection-title {
    color: var(--primary);
    font-size: 23px;
    margin: 30px 0 18px;
}

.alat-card {
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: var(--shadow);
    margin: 24px 0;
}

.alat-header {
    padding: 20px 25px;
    background: #e5f4f8;
    border-bottom: 1px solid var(--border);
}

.alat-header small {
    display: block;
    color: #159baf;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.alat-header h3 {
    color: var(--primary);
    font-size: 21px;
    line-height: 1.45;
}

.alat-body {
    padding: 24px;
}

.alat-photo-area {
    display: flex;
    justify-content: center;
    margin-bottom: 22px;
}

.kotak-foto-alat {
    width: 100%;
    max-width: 500px;
    text-align: center;
    background: #f8fbfc;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 14px;
}

.kotak-foto-alat img {
    width: 100%;
    height: 270px;
    object-fit: contain;
    border-radius: 8px;
}

.photo-caption,
.foto-langkah-wrap p {
    color: var(--muted);
    font-size: 12px;
    margin-top: 9px;
    text-align: center;
}

.persiapan-box,
.langkah-box {
    background: #f8fbfc;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    margin: 18px 0;
}

.persiapan-box h4,
.langkah-box h4 {
    color: var(--primary);
    margin-bottom: 10px;
    font-size: 17px;
}

.persiapan-box ul,
.langkah-box ol {
    padding-left: 23px;
}

.persiapan-box li,
.langkah-box li {
    margin-bottom: 8px;
}

.foto-langkah-wrap {
    max-width: 650px;
    margin: 24px auto 5px;
    text-align: center;
}

.foto-langkah {
    width: 60%;
    max-height: 440px;
    object-fit: contain;
    background: #f8fbfc;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 8px;
}

.pb-tb-intro {
    font-weight: 600;
    color: var(--primary);
}

.pb-tb-options {
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: 14px;
    margin: 18px 0;
}

.umur-box,
.berdiri-box {
    padding: 20px;
    border-radius: 12px;
    background: #e9f9fa;
    color: var(--primary);
    font-weight: 700;
    text-align: center;
    border: 1px solid #c8eeee;
}

/* HOTLINE */
.hotline-card {
    text-align: center;
    background: var(--primary);
    color: white;
    border-radius: 20px;
    padding: 35px 25px;
}

.hotline-card h3 {
    font-size: 25px;
    margin-bottom: 10px;
}

.hotline-card p {
    margin-bottom: 15px;
}

.hotline-number {
    display: inline-block;
    padding: 10px 20px;
    border-radius: 30px;
    background: var(--secondary);
    color: #063b56;
    font-weight: 800;
}

.social-contact {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    margin: 15px 0;
}

.social-contact a {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 40px;
    height: 40px;
    border-radius: 40%;
    background: #fff;
    color: #084873;
    font-size: 22px;
    transition: .3s;
}

.social-contact a:hover {
    background: #35c9c9;
    transform: translateY(-4px);
}

/* FOOTER */
footer {
    background: #063451;
    color: #fff;
    padding: 25px;
    text-align: center;
    font-size: 12px;
}

.back-to-top {
    position: fixed;
    right: 20px;
    bottom: 20px;
    width: 45px;
    height: 45px;
    display: none;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 50%;
    background: var(--primary);
    color: #fff;
    font-size: 22px;
    cursor: pointer;
    box-shadow: var(--shadow);
    z-index: 900;
}

.back-to-top.show {
    display: flex;
}

/* PEMBESAR FOTO */
.image-modal {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(0,0,0,.88);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 25px;
}

.image-modal.show {
    display: flex;
}

.image-modal img {
    max-width: 95%;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 10px;
}

.modal-close {
    position: absolute;
    top: 18px;
    right: 25px;
    background: transparent;
    color: #fff;
    border: 0;
    font-size: 38px;
    cursor: pointer;
}

